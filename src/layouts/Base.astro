---
import '../styles/site.css';
import Logo from '../components/Logo.astro';
import site from '../../site.config.mjs';

interface Props {
  title: string;
  description: string;
  /** Wordmark in the simple header links home (true) or is plain (false, root page). */
  homeLink?: boolean;
  /** Landing pages only: marks <html> so the header CTA can start hidden without a flash. */
  js?: boolean;
  /** JSON-LD objects for this page. */
  schema?: object[];
}
const { title, description, homeLink = true, js = false, schema = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/nightporter-og-image.png', Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/nightporter-monogram-small.svg" type="image/svg+xml" />
    <link rel="icon" href="/nightporter-monogram-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/nightporter-monogram-180.png" />
    <meta name="theme-color" content="#F5F3EE" />
    <meta property="og:site_name" content="Night Porter" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Night Porter" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    {schema.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
    <link rel="preload" href="/fonts/archivo-700-800.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/plex-sans-400-600.woff2" as="font" type="font/woff2" crossorigin />
    {js && <script is:inline>document.documentElement.classList.add('js')</script>}
  </head>
  <body>
    {
      Astro.slots.has('header') ? (
        <slot name="header" />
      ) : (
        <header class="hdr">
          <div class="wrap hdr-in">
            {homeLink ? (
              <a href="/" class="hdr-logo" aria-label="Night Porter home">
                <Logo width={132} first />
              </a>
            ) : (
              <span class="hdr-logo">
                <Logo width={132} first label="Night Porter" />
              </span>
            )}
          </div>
        </header>
      )
    }
    <slot />
    <footer class="ftr">
      <div class="wrap ftr-in">
        <Logo width={114} label="Night Porter" />
        <span>© 2026 Night Porter</span>
        <a href="/privacy/">Privacy</a>
        <a href="/data/">Data</a>
        <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>
      </div>
    </footer>
    <slot name="end" />
  </body>
</html>
