// Cloudflare Workers deploy config. Its presence stops `wrangler deploy` from auto-configuring
// the project (which ran `astro add cloudflare` and pulled in an Astro that needs a newer Node).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "night-porter",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": true,
  "previews": {},
  "build": { "command": "npm run build" },
  // TODO(Petar): create the KV namespace (npx wrangler kv namespace create LEADS, or the dashboard) and replace
  // this placeholder with its id. Deploys fail until it is a real namespace id.
  "kv_namespaces": [{ "binding": "LEADS", "id": "TODO_REPLACE_WITH_LEADS_NAMESPACE_ID" }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  }
}
